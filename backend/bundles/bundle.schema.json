{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "twin_export day bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "date",
    "timezone",
    "grid_s",
    "synthetic",
    "samples",
    "day"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "subject": {"type": "string", "minLength": 1},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "timezone": {"type": "string", "minLength": 1},
    "grid_s": {"const": 60},
    "synthetic": {"type": "boolean"},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t",
          "hr",
          "hr_n",
          "ae_kcal_min",
          "be_kcal_min",
          "steps_min",
          "t_app_c",
          "rh_pct",
          "workout"
        ],
        "properties": {
          "t": {"type": "integer", "minimum": 0},
          "hr": {
            "type": ["number", "null"],
            "minimum": 20,
            "maximum": 240
          },
          "hr_n": {"type": "integer", "minimum": 0},
          "ae_kcal_min": {"type": ["number", "null"], "minimum": 0},
          "be_kcal_min": {"type": ["number", "null"], "minimum": 0},
          "steps_min": {"type": ["number", "null"], "minimum": 0},
          "t_app_c": {"type": ["number", "null"]},
          "rh_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "workout": {"type": ["string", "null"]}
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hr_level_rts",
        "n_minutes",
        "minutes_with_hr",
        "coverage_hr_min_frac",
        "coverage_hr_hours",
        "dense_minutes",
        "basal_source"
      ],
      "properties": {
        "hr_level_rts": {"type": ["number", "null"]},
        "n_minutes": {"type": "integer", "minimum": 1},
        "minutes_with_hr": {"type": "integer", "minimum": 0},
        "coverage_hr_min_frac": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage_hr_hours": {"type": "integer", "minimum": 0, "maximum": 25},
        "dense_minutes": {"type": "integer", "minimum": 0},
        "basal_source": {"type": "string", "enum": ["measured", "subject_median", "synthetic"]}
      }
    }
  }
}
